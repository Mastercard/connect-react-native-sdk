{
  "name": "connect-react-native-sdk",
  "version": "2.2.0",
  "description": "React Native SDK for Mastercard Open Finance Connect",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "license": "MIT",
  "author": "connect-react-native-sdk",
  "homepage": "https://github.com/Mastercard/connect-react-native-sdk",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!src/**/*.test.*",
    "!lib/**/*.test.*",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "Mastercard",
    "Mastercard Open Finance Connect"
  ],
  "scripts": {
    "example": "yarn workspace connect-react-native-sdk-example",
    "ci:ensure-dev-tools": "node -e \"const fs=require('fs'); const cp=require('child_process'); const tools=['jest','prettier']; const missing=tools.filter(tool=>!fs.existsSync('node_modules/.bin/'+tool)); if(missing.length===0){process.exit(0);} if(process.env.CI){console.log('[ci:ensure-dev-tools] Installing missing dev tools: '+missing.join(', ')); cp.execSync('yarn install --production=false --frozen-lockfile --non-interactive',{stdio:'inherit'});} else {console.warn('[ci:ensure-dev-tools] Missing dev tools locally: '+missing.join(', '));}\"",
    "test": "yarn ci:ensure-dev-tools && jest ./src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prebuild": "node scripts/generate-version.js",
    "build": "bob build && npm pack",
    "prettier-check": "yarn ci:ensure-dev-tools && prettier --check ./src/",
    "prettier-write": "prettier --write .",
    "test:version_bump": "test $npm_package_version != $(npm show $npm_package_name version) || (echo 'Failing... You must bump package.json and package-lock.json' && exit 1)"
  },
  "dependencies": {
    "react-native-url-polyfill": "4.0.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/config-conventional": "^21.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "braces": "file:patched-deps/braces-3.0.4.tgz",
    "commitlint": "^21.2.0",
    "del-cli": "^7.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "pod-install": "^1.0.15",
    "prettier": "3.9.4",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-builder-bob": "0.43.0",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-native": ">=0.87.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-webview": "14.0.1"
  },
  "overrides": {
    "braces": "$braces",
    "image-size": "2.0.4",
    "flatted": "^3.4.2",
    "minimatch": "^3.1.5",
    "shell-quote": "^1.11.0",
    "js-yaml": "^4.1.1",
    "argparse": "^2.0.1"
  },
  "resolutions": {
    "braces": "file:patched-deps/braces-3.0.4.tgz",
    "image-size": "2.0.4",
    "flatted": "^3.4.2",
    "minimatch": "^3.1.5",
    "shell-quote": "^1.11.0",
    "js-yaml": "^4.1.1",
    "argparse": "^2.0.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "none",
          "useTabs": false,
          "arrowParens": "avoid"
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false,
    "arrowParens": "avoid"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">= 22.13.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
